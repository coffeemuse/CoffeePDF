+// Swaps this item's NSMenuItem for a fresh one that carries everything the old one did, in the same
+// place. See RenewMenuBarItems for why a menu-bar title needs this.
+void AvnAppMenuItem::Renew()
+{
+    if(![_native isKindOfClass:[AvnMenuItem class]])
+        return;
+
+    NSMenuItem* old = _native;
+    AvnMenuItem* fresh = [[AvnMenuItem alloc] initWithAvnAppMenuItem: this];
+
+    [fresh setTitle:[old title]];
+    [fresh setToolTip:[old toolTip]];
+    [fresh setKeyEquivalent:[old keyEquivalent]];
+    [fresh setKeyEquivalentModifierMask:[old keyEquivalentModifierMask]];
+    [fresh setState:[old state]];
+    [fresh setOnStateImage:[old onStateImage]];
+    [fresh setImage:[old image]];
+    [fresh setHidden:[old isHidden]];
+    [fresh setEnabled:[old isEnabled]];
+    [fresh setTarget:[old target] == old ? fresh : [old target]];
+    [fresh setAction:[old action]];
+
+    NSMenu* parent = [old menu];
+    NSInteger index = parent != nullptr ? [parent indexOfItem:old] : -1;
+    NSMenu* submenu = [old submenu];
+
+    if(parent != nullptr)
+        [parent removeItem:old];
+
+    // A submenu may belong to one item at a time.
+    [old setSubmenu:nullptr];
+    [fresh setSubmenu:submenu];
+
+    if(parent != nullptr)
+        [parent insertItem:fresh atIndex:index];
+
+    if(s_appMenuItem == old)
+        s_appMenuItem = fresh;
+
+    _native = fresh;
+}
+
+// **Gives every title of a menu bar a fresh NSMenuItem, just before that bar is installed.**
+//
+// macOS 27: if NSApp's menu is replaced within ~100 ms of a menu item's key equivalent, the top-level
+// title that item lives under stops opening for good — clicked, it highlights and nothing drops down.
+// The damage belongs to that title's NSMenuItem object: its neighbours keep working, re-inserting the
+// same object does not help, and a new NSMenuItem carrying the same submenu opens normally. A window
+// switch is such a replacement, and opening a window is what a shortcut usually does, so the two land
+// a millisecond apart. Renewing the titles on every install means a damaged one never reaches the
+// screen. Only while the bar is not installed: an installed bar edited in place is not repainted.
+void RenewMenuBarItems(NSMenu* bar)
+{
+    if(bar == nullptr || [NSApp mainMenu] == bar)
+        return;
+
+    for(NSMenuItem* item in [[bar itemArray] copy])
+    {
+        if(![item isKindOfClass:[AvnMenuItem class]])
+            continue;
+
+        auto owner = [(AvnMenuItem*)item owner];
+
+        if(owner != nullptr)
+            owner->Renew();
+    }
+}
