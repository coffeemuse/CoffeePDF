<Project Sdk="Microsoft.NET.Sdk">
  <!-- The app's tests, with Avalonia headless, and Phase 0's checks of the PdfViewer (spec §14). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <Import Project="../AvaloniaLicense.props" />
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <!-- These fixtures live with the core's tests, which need them without the app; the app's tests compile them too. -->
    <Compile Include="../CoffeePdf.Core.Tests/Fixtures/MinimalPdf.cs" Link="Fixtures/MinimalPdf.cs" />
    <Compile Include="../CoffeePdf.Core.Tests/Fixtures/EncryptedPdf.cs" Link="Fixtures/EncryptedPdf.cs" />
    <Compile Include="../CoffeePdf.Core.Tests/Fixtures/AnnotatedPdf.cs" Link="Fixtures/AnnotatedPdf.cs" />
    <Compile Include="../CoffeePdf.Core.Tests/Fakes/FakeHelper.cs" Link="Fakes/FakeHelper.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The app's tests run on macOS (spec §10), so Unix-only calls such as File.SetUnixFileMode are fine. -->
    <AssemblyAttribute Include="System.Runtime.Versioning.UnsupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="../CoffeePdf/CoffeePdf.csproj" />
  </ItemGroup>
</Project>
